{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_telegram-mcp_telegram__tg_(messages_(send|edit|delete|forward|react|pin|unpin|read)|chats_(mark_read|create|join|leave|edit)|topics_create|invites_create|admins_set|profile_edit|files_send)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" approval-pre",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|Task|Agent|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" approval-post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
