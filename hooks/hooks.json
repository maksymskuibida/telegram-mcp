{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_telegram-mcp_telegram__tg_messages_send",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" approval-pre",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|Task|Agent|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" approval-post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
